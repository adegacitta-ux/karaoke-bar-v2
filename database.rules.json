{
  "rules": {
    "bares": {
      "$barId": {
        "config": {
          ".read": true,
          ".write": false
        },

        "karaoke": {
          ".read": true,
          ".write": "auth != null && auth.token.email == root.child('bares/' + $barId + '/config/adminEmail').val()",

          "fila": {
            "$pedidoId": {
              ".write": "(auth != null && auth.token.email == root.child('bares/' + $barId + '/config/adminEmail').val()) || (auth != null && ((!data.exists() && newData.child('criadoPor').val() == auth.uid) || (data.exists() && data.child('criadoPor').val() == auth.uid)))",
              ".validate": "newData.hasChildren(['nome', 'musica', 'deviceId', 'timestamp', 'timestampFila', 'vezesCantadas', 'criadoPor'])",
              "ausenteDesde": { ".validate": "newData.val() == null || newData.isNumber()" },
              "nome": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
              "mesa": { ".validate": "newData.val() == null || (newData.isString() && newData.val().length <= 20)" },
              "musica": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120 && !newData.val().matches(/^https?:\\/\\//)" },
              "artista": { ".validate": "newData.val() == null || (newData.isString() && newData.val().length <= 80)" },
              "deviceId": { ".validate": "newData.isString() && newData.val().length <= 100" },
              "timestamp": { ".validate": "newData.isNumber()" },
              "timestampFila": { ".validate": "newData.isNumber()" },
              "vezesCantadas": { ".validate": "newData.isNumber()" },
              "youtubeUrl": { ".validate": "newData.val() == null || (newData.isString() && newData.val().length <= 200 && newData.val().matches(/^https:\\/\\/(www\\.)?(youtube\\.com|youtu\\.be)\\/.+/))" },
              "criadoPor": { ".validate": "newData.isString() && newData.val() == auth.uid" },
              "$other": { ".validate": false }
            }
          },

          "dispositivosBloqueados": {
            "$deviceId": {
              ".validate": "newData.isBoolean()"
            }
          },

          "apresentacaoAtual": {
            "avaliacoes": {
              "$votanteId": {
                ".write": "auth != null && $votanteId == auth.uid",
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
              }
            }
          },

          "historicoPermanente": {
            ".indexOn": "timestamp"
          }
        }
      }
    }
  }
}
