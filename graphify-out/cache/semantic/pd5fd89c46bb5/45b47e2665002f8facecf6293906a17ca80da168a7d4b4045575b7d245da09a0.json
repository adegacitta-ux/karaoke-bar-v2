{"nodes": [{"id": "refactoring_plano_refatoracao", "label": "Refactoring Plan Overview", "file_type": "document", "source_file": "REFACTORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "refactoring_remover_credenciais_hardcoded", "label": "Remove Hardcoded Credentials", "file_type": "rationale", "rationale": "YouTube and Firebase API keys are exposed in public client-side source, risking API abuse; move config behind a backend endpoint or gitignored .env.local.", "source_file": "REFACTORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "refactoring_dividir_html_modulos", "label": "Split HTML into JS Modules", "file_type": "rationale", "rationale": "1000+ line monolithic index.html is hard to maintain; propose src/js/{config,modules,utils}/app.js structure for testability, debuggability, reuse, and better browser caching.", "source_file": "REFACTORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "refactoring_otimizar_carregamento_scripts", "label": "Optimize Script Loading", "file_type": "rationale", "rationale": "Synchronous CDN <script> tags (Tailwind, Font Awesome, Firebase) block rendering; use defer/preload, static Tailwind build, and skeleton screens.", "source_file": "REFACTORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "refactoring_validacao_formulario", "label": "Improve Form Validation", "file_type": "rationale", "rationale": "Existing validation is insufficient with no error feedback; centralize a VALIDATORS map with per-field messages, real-time feedback, and XSS sanitization.", "source_file": "REFACTORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "refactoring_gerenciamento_estado", "label": "Centralized State Management", "file_type": "rationale", "rationale": "Global state (fila, historico, apresentacaoAtual, etc.) is scattered without a clear pattern; propose a KaraokeStore pub/sub class with setState/subscribe to replace ad hoc globals.", "source_file": "REFACTORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "refactoring_acessibilidade", "label": "Accessible Labels", "file_type": "rationale", "rationale": "Buttons and inputs lack aria-label/associated labels; add aria-label, aria-hidden on decorative icons, aria-live on dynamic areas, and verify WCAG AA contrast.", "source_file": "REFACTORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "refactoring_semantica_html", "label": "Improve HTML Semantics", "file_type": "rationale", "rationale": "Generic divs lack semantic meaning; use section/article/aside, role=tabpanel for tabs, and a proper heading hierarchy.", "source_file": "REFACTORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "refactoring_testes_unitarios", "label": "Add Unit Tests", "file_type": "rationale", "rationale": "No tests exist to guarantee quality; add Jest unit/integration/e2e tests for validators, formatters, and queue-manager plus CI.", "source_file": "REFACTORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "refactoring_logging_estruturado", "label": "Structured Logging", "file_type": "rationale", "rationale": "console.log calls are scattered with no consistent pattern; add a leveled Logger class (DEBUG/INFO/WARN/ERROR) with per-module context.", "source_file": "REFACTORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "refactoring_tratamento_erros", "label": "Improve Error Handling", "file_type": "rationale", "rationale": "Missing try/catch leads to silent failures; wrap Firebase calls in async/await with try/catch, add error boundaries and user-friendly error messages.", "source_file": "REFACTORING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "refactoring_plano_refatoracao", "target": "refactoring_remover_credenciais_hardcoded", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REFACTORING.md", "source_location": null, "weight": 1.0}, {"source": "refactoring_plano_refatoracao", "target": "refactoring_dividir_html_modulos", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REFACTORING.md", "source_location": null, "weight": 1.0}, {"source": "refactoring_plano_refatoracao", "target": "refactoring_otimizar_carregamento_scripts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REFACTORING.md", "source_location": null, "weight": 1.0}, {"source": "refactoring_plano_refatoracao", "target": "refactoring_validacao_formulario", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REFACTORING.md", "source_location": null, "weight": 1.0}, {"source": "refactoring_plano_refatoracao", "target": "refactoring_gerenciamento_estado", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REFACTORING.md", "source_location": null, "weight": 1.0}, {"source": "refactoring_plano_refatoracao", "target": "refactoring_acessibilidade", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REFACTORING.md", "source_location": null, "weight": 1.0}, {"source": "refactoring_plano_refatoracao", "target": "refactoring_semantica_html", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REFACTORING.md", "sou